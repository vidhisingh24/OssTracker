{
  "name": "contrib",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Self-hosted dashboard tracking every open-source issue, PR, review and CI result you are involved in.",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @contrib/web --filter @contrib/worker dev",
    "dev:web": "pnpm --filter @contrib/web dev",
    "dev:worker": "pnpm --filter @contrib/worker dev",
    "build": "pnpm --filter @contrib/web build",
    "start": "pnpm --filter @contrib/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @contrib/web e2e",
    "db:generate": "pnpm --filter @contrib/core db:generate",
    "db:migrate": "pnpm --filter @contrib/core db:migrate",
    "db:seed": "pnpm --filter @contrib/core db:seed",
    "check:contrast": "tsx scripts/check-contrast.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "15.5.27",
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
