# ─────────────────────────────────────────────────────────────────────────────
# Contrib configuration. Copy to `.env` and fill in what you need.
# With nothing set, Contrib runs in DEMO MODE on an embedded database with fake data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public URL of the app (used for OAuth callbacks and links in notifications).
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. Required for the worker (pg-boss queue) and for real sync.
# Leave empty to use embedded PGlite (demo / quick local preview only, single process).
DATABASE_URL=postgres://contrib:contrib@localhost:5433/contrib
# Directory for the embedded PGlite database when DATABASE_URL is empty.
PGLITE_DIR=

# ── Auth (GitHub OAuth via Auth.js) ──────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Random 32+ byte secret for signing session cookies: `openssl rand -base64 32`
AUTH_SECRET=
# Only this GitHub login may sign in.
ALLOWED_GITHUB_LOGIN=vidhisingh24
# 32-byte key (base64 or hex) used to encrypt the OAuth token at rest (AES-256-GCM).
#   `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# Request the `repo` scope (instead of `public_repo`) so private repositories are tracked.
GITHUB_PRIVATE_REPOS=false
# Optional personal access token fallback (classic: read:user, notifications, public_repo).
# Lets the worker sync without an OAuth login. OAuth token wins when both exist.
GITHUB_TOKEN=

# worker = separate worker process (docker compose); inline = serverless/Vercel (auto-detected).
SYNC_MODE=
# Secret for the scheduled sync endpoint /api/cron/sync (called by .github/workflows/sync.yml).
#   `openssl rand -base64 32`
CRON_SECRET=

# Force demo mode even if credentials are present (read-only showcase deployments).
DEMO_MODE=false

# ── Webhooks (only for repos you own/maintain; off by default) ───────────────
WEBHOOKS_ENABLED=false
GITHUB_WEBHOOK_SECRET=

# ── External notifications (all optional, off unless configured) ─────────────
# Email via Resend
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy (full topic URL, e.g. https://ntfy.sh/my-secret-topic) and optional access token
NTFY_URL=
NTFY_TOKEN=
